[Unit]
Description=Generate and validate ClubDailyFive daily football quizzes
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
EnvironmentFile=-/etc/clubdailyfive/quiz-agent.env
ExecStart=/usr/bin/python3 /opt/clubdailyfive/bin/agent_job_reporter.py questions
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/clubdailyfive /var/backups/clubdailyfive-question-db
NoNewPrivileges=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictRealtime=true
UMask=0027
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target

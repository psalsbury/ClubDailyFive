[Unit]
Description=Generate and validate PredictionComp daily football quizzes
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=www-data
Group=www-data
EnvironmentFile=-/etc/predictioncomp/quiz-agent.env
ExecStart=/usr/bin/python3 /opt/predictioncomp/bin/generate_questions.py
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/predictioncomp /var/backups/predictioncomp-question-db
NoNewPrivileges=true
LockPersonality=true
MemoryDenyWriteExecute=true
RestrictSUIDSGID=true
RestrictRealtime=true
UMask=0027
TimeoutStartSec=3600

[Install]
WantedBy=multi-user.target

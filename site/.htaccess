DirectoryIndex index.php
Options -Indexes

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Permanent, descriptive search landing pages and clean game URLs.
  RewriteRule ^clubs/([a-z0-9-]+)/?$ seo.php?type=club&club=$1 [L,QSA]
  RewriteRule ^daily-five/([a-z0-9-]+)/?$ index.php?club=$1 [L,QSA]
  RewriteRule ^daily-football-quiz/?$ seo.php?type=daily [L,QSA]
  RewriteRule ^player-wordle-game/?$ seo.php?type=wordle [L,QSA]
  RewriteRule ^player-wordle/([a-z0-9-]+)/?$ player-wordle/game.php?club=$1 [L,QSA]
  RewriteRule ^sitemap\.xml$ sitemap.php [L]

  # Friendly public information pages.
  RewriteRule ^(about|privacy|contact|how-it-works)/?$ info.php?page=$1 [L,QSA]

  # Keep one indexable origin. Preserve the path and query string so club
  # links continue to open the requested quiz after the permanent redirect.
  RewriteCond %{HTTPS} !=on [OR]
  RewriteCond %{HTTP_HOST} !^clubdailyfive\.com$ [NC]
  RewriteRule ^ https://clubdailyfive.com%{REQUEST_URI} [R=301,L,NE]
</IfModule>

<FilesMatch "\.(sqlite|db|sql|bak)$">
  Require all denied
</FilesMatch>
<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), camera=(), microphone=()"
</IfModule>
